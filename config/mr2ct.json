{
    "name": "mr2ct", // experiments name
    "gpu_ids": [0],
    "seed" : -1,
    "finetune_norm": false,

    "path": {
        "base_dir": "experiments",
        "code": "code",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },

    "datasets": {
        "train": { 
            "which_dataset": {
                "name": ["data.dataset", "MR2CTDataset"],
                "args":{
                    "data_root": "datasets/mr2ct",
                    "split": "train",
                    "data_len": -1,
                    "image_size": [256, 256],
                    "mr_mean": 0.0, // replace with MR channel mean of your dataset
                    "mr_std": 1.0,  // replace with MR channel std of your dataset
                    "ct_mean": 0.0, // replace with CT channel mean of your dataset
                    "ct_std": 1.0   // replace with CT channel std of your dataset
                } 
            },
            "dataloader":{
                "validation_split": 0.1,
                "args":{
                    "batch_size": 4,
                    "num_workers": 4,
                    "shuffle": true,
                    "pin_memory": true,
                    "drop_last": true
                },
                "val_args":{
                    "batch_size": 1,
                    "num_workers": 4,
                    "shuffle": false,
                    "pin_memory": true,
                    "drop_last": false
                }
            }
        },
        "test": { 
            "which_dataset": {
                "name": ["data.dataset", "MR2CTDataset"],
                "args":{
                    "data_root": "datasets/mr2ct",
                    "split": "test",
                    "image_size": [256, 256],
                    "mr_mean": 0.0, // keep in sync with train normalization
                    "mr_std": 1.0,
                    "ct_mean": 0.0,
                    "ct_std": 1.0
                }
            },
            "dataloader":{
                "args":{
                    "batch_size": 2,
                    "num_workers": 4,
                    "pin_memory": true
                }
            }
        }
    },

    "model": {
        "which_model": {
            "name": ["models.model", "Palette"],
            "args": {
                "sample_num": 8,
                "task": "mr2ct",
                "ema_scheduler": {
                    "ema_start": 1,
                    "ema_iter": 1,
                    "ema_decay": 0.9999
                },
                "optimizers": [
                    { "lr": 5e-5, "weight_decay": 0}
                ]
            }
        }, 
        "which_networks": [
            {
                "name": ["models.network", "Network"],
                "args": {
                    "init_type": "kaiming",
                    "module_name": "guided_diffusion",
                    "unet": {
                        "in_channel": 2,
                        "out_channel": 1,
                        "inner_channel": 64,
                        "channel_mults": [
                            1,
                            2,
                            4,
                            8
                        ],
                        "attn_res": [
                            16
                        ],
                        "num_head_channels": 32,
                        "res_blocks": 2,
                        "dropout": 0.2,
                        "image_size": 256
                    },
                    "beta_schedule": {
                        "train": {
                            "schedule": "linear",
                            "n_timestep": 2000,
                            "linear_start": 1e-6,
                            "linear_end": 0.01
                        },
                        "test": {
                            "schedule": "linear",
                            "n_timestep": 1000,
                            "linear_start": 1e-4,
                            "linear_end": 0.09
                        }
                    }
                }
            }
        ],
        "which_losses": [
            "mse_loss"
        ],
        "which_metrics": [
            "mae"
        ]
    },

    "train": {
        "n_epoch": 1e8,
        "n_iter": 1e8,
        "val_epoch": 5,
        "save_checkpoint_epoch": 10,
        "log_iter": 1e4,
        "tensorboard" : true
    },
    
    "debug": {
        "val_epoch": 1,
        "save_checkpoint_epoch": 1,
        "log_iter": 10,
        "debug_split": 50
    }
}
